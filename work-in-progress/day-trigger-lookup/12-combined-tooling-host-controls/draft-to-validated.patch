+class CombinedWorkflowControls(unittest.TestCase):
+    def setUp(self):
+        self.root = Path(__file__).resolve().parents[2]
+        self.workflow = (self.root / '.github/workflows/day-trigger-wip-acceptance.yml').read_text()
+
+    def test_workflow_runtime_pin_binds_all_seven_actual_runtime_siblings(self):
+        line = next(value for value in self.workflow.splitlines() if 'DAY_TRIGGER_RUNTIME_MANIFEST_SHA256:' in value)
+        digest = line.split("'")[1]
+        value = inputs.verify_runtime_manifest(digest)
+        self.assertEqual(7, len(value['files']))
+        self.assertEqual(9, sum(p.is_file() for p in self.root.rglob('*')))
+
+    def test_exact_lookup_checkout_and_all_three_required_cli_boundaries(self):
+        pins = inputs.load_pins()
+        block = self.workflow.split('- name: Check out both immutable lookup source capsules\n', 1)[1].split('      - name:', 1)[0]
+        self.assertIn('ref: ' + pins['lookup_commit'] + '\n', block)
+        for row in pins['lookup_capsules'].values():
+            self.assertIn('            ' + row['path'] + '\n', block)
+        self.assertEqual(3, self.workflow.count('--lookup-repository lookup-repository'))
+        self.assertIn('--destination combined-workspace', self.workflow)
+        self.assertIn('timeout 300s python3 -B -m unittest discover', self.workflow)
+
+    def test_only_the_two_new_paths_trigger_this_additive_job(self):
+        trigger = self.workflow.split('on:\n', 1)[1].split('\npermissions:', 1)[0]
+        paths = [line.strip() for line in trigger.splitlines() if line.strip().startswith('- ')]
+        self.assertEqual(["- 'tools/day_trigger_acceptance/**'", "- '.github/workflows/day-trigger-wip-acceptance.yml'"] * 2, paths)
+        self.assertIn('  workflow_dispatch:\n', trigger)
+        self.assertIn('cancel-in-progress: false', self.workflow)
+
+    def test_actual_failure_verification_and_complete_owned_artifacts_remain_unconditional(self):
+        verifier = self.workflow.split('- name: Independently verify the actual complete result and preserve any failure\n', 1)[1].split('      - name:', 1)[0]
+        self.assertIn("if: always() && steps.tool-inputs.outcome == 'success'", verifier)
+        upload = self.workflow.split('- name: Preserve complete WIP inputs, reports, APKs and literal outcomes\n', 1)[1]
+        self.assertIn('if: always()\n', upload)
+        self.assertIn('include-hidden-files: true\n', upload)
+        self.assertIn('if-no-files-found: error\n', upload)
+        self.assertIn('job-source/.github/workflows/day-trigger-wip-acceptance.yml', upload)
+        self.assertIn('combined-workspace/MacroDroid_v9/reports/', upload)
+        self.assertIn('hosted-tool-control-evidence/', upload)
+
+
 if __name__ == '__main__':
